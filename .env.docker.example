APP_ENV=development
ARTIFACT_DIR=/app/backend/artifacts/current
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=30
MAX_REQUEST_BYTES=32768

# .env.postgres의 사용자·비밀번호와 일치시킨다.
DATABASE_URL=postgresql+psycopg://kb:change-me-before-first-run@db:5432/kb
BIZINFO_API_KEY=

DATA_GO_KR_SERVICE_KEY=
SBIZ_STORE_API_BASE_URL=https://apis.data.go.kr/B553077/api/open/sdsc2
STORE_CACHE_TTL_SECONDS=86400
STORE_STALE_TTL_SECONDS=604800
STORE_API_TIMEOUT_SECONDS=15

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AGENT_TIMEOUT_SECONDS=30
WORKSPACE_AGENT_TIMEOUT_SECONDS=60
AGENT_MAX_TURNS=4
AGENT_RATE_LIMIT_PER_MINUTE=10
WEB_RESEARCH_TIMEOUT_SECONDS=45

VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
