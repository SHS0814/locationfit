# Seoul Open Data collection
SEOUL_API_KEY=

# Small Enterprise and Market Service store information API
DATA_GO_KR_SERVICE_KEY=
SBIZ_STORE_API_BASE_URL=https://apis.data.go.kr/B553077/api/open/sdsc2
STORE_CACHE_TTL_SECONDS=86400
STORE_STALE_TTL_SECONDS=604800
STORE_API_TIMEOUT_SECONDS=15
STORE_RATE_LIMIT_PER_MINUTE=5

# OpenAI location agent (server-side only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AGENT_TIMEOUT_SECONDS=30
WORKSPACE_AGENT_TIMEOUT_SECONDS=60
AGENT_MAX_TURNS=4
AGENT_RATE_LIMIT_PER_MINUTE=10
WEB_RESEARCH_TIMEOUT_SECONDS=45

# Competition demo access protection (server-side only)
AI_SECURITY_ENABLED=true
AI_ACCESS_CODE=
AI_SESSION_SECRET=
AI_SESSION_TTL_SECONDS=28800
AI_GLOBAL_RATE_LIMIT_PER_MINUTE=10
AI_DAILY_REQUEST_LIMIT=100
AI_DAILY_BUDGET_USD=5.00
AI_MAX_CONCURRENT_REQUESTS=2
AI_LEASE_TIMEOUT_SECONDS=120
AI_AGENT_REQUEST_RESERVATION_USD=0.10
AI_WORKSPACE_REQUEST_RESERVATION_USD=0.20
AI_WEB_RESEARCH_REQUEST_RESERVATION_USD=0.25

# Web API
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Financial-support catalog database
DATABASE_URL=postgresql+psycopg://kb:change-me-before-first-run@localhost:5432/kb
BIZINFO_API_KEY=
