# Seoul Open Data collection
SEOUL_API_KEY=
# 한국부동산원 R-ONE 수동 임대료 갱신 전용(웹 런타임에서는 사용하지 않음)
REB_API_KEY=

# OpenAI location agent (server-side only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AGENT_TIMEOUT_SECONDS=30
AGENT_MAX_TURNS=4
AGENT_RATE_LIMIT_PER_MINUTE=10

# Web API
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
