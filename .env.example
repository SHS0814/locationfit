# Seoul Open Data collection
SEOUL_API_KEY=

# Small Enterprise and Market Service store information API
DATA_GO_KR_SERVICE_KEY=
SBIZ_STORE_API_BASE_URL=https://apis.data.go.kr/B553077/api/open/sdsc2
STORE_CACHE_TTL_SECONDS=86400
STORE_STALE_TTL_SECONDS=604800
STORE_API_TIMEOUT_SECONDS=15

# OpenAI location agent (server-side only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AGENT_TIMEOUT_SECONDS=30
AGENT_MAX_TURNS=4
AGENT_RATE_LIMIT_PER_MINUTE=10
WEB_RESEARCH_TIMEOUT_SECONDS=45

# Web API
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
